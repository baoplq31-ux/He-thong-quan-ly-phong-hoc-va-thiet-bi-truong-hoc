generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  building       String
  floor          String
  type           String
  capacity       Int
  status         String
  equipmentCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  equipments Equipment[]
  bookings   Booking[]
  incidents  Incident[]

  @@map("rooms")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  type        String
  quantity    Int
  status      String
  lastChecked String
  roomId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@map("equipment")
}

model Booking {
  id        Int      @id @default(autoincrement())
  date      String
  time      String
  course    String
  person    String
  status    String
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([date])
  @@map("bookings")
}

model Incident {
  id         Int      @id @default(autoincrement())
  title      String
  reportedBy String
  time       String
  severity   String
  status     String
  roomId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([status])
  @@map("incidents")
}

model SystemUser {
  sessions Session[]
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         String
  department   String
  status       String
  lastLogin    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id        Int        @id @default(autoincrement())
  tokenHash String     @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime   @default(now())

  user SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
